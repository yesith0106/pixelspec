{
  "name": "pixelspec",
  "version": "0.3.0",
  "description": "Visual feedback and CSS inspector for AI coding agents. Measure spacing, typography and color contrast on your live site, pin notes to any element, and copy pixel-perfect feedback for Claude Code, Cursor, Codex or Copilot.",
  "license": "MIT",
  "author": "Yesith (https://github.com/yesith0106)",
  "homepage": "https://www.pixelspec.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yesith0106/pixelspec.git"
  },
  "bugs": {
    "url": "https://github.com/yesith0106/pixelspec/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./global": "./dist/pixelspec.global.js"
  },
  "unpkg": "./dist/pixelspec.global.js",
  "jsdelivr": "./dist/pixelspec.global.js",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "demo": "node scripts/serve.mjs",
    "brand": "node scripts/brand-export.mjs",
    "size": "node scripts/size.mjs",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@types/react": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "css inspector",
    "spacing inspector",
    "design qa",
    "visual feedback",
    "ui feedback",
    "pixel perfect",
    "redline",
    "measure",
    "padding",
    "margin",
    "typography",
    "color contrast",
    "wcag",
    "devtools",
    "overlay",
    "ai agent",
    "ai coding",
    "vibe coding",
    "claude code",
    "cursor",
    "copilot",
    "codex",
    "design handoff",
    "react",
    "nextjs",
    "vite"
  ]
}
