{
  "name": "pixelspec",
  "version": "0.2.0",
  "description": "Design inspector and spacing overlay for any website: measure padding, margin, gaps, distances, typography, colors and contrast, then copy AI-ready feedback.",
  "license": "MIT",
  "author": "Yesith (https://github.com/yesith0106)",
  "homepage": "https://github.com/yesith0106/pixelspec#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yesith0106/pixelspec.git"
  },
  "bugs": {
    "url": "https://github.com/yesith0106/pixelspec/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./global": "./dist/pixelspec.global.js"
  },
  "unpkg": "./dist/pixelspec.global.js",
  "jsdelivr": "./dist/pixelspec.global.js",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "demo": "node scripts/serve.mjs",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@types/react": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "design inspector",
    "css inspector",
    "spacing",
    "measure",
    "redline",
    "pixel perfect",
    "design qa",
    "devtools",
    "overlay",
    "typography",
    "letter spacing",
    "contrast",
    "ai agent",
    "visual feedback",
    "agentation alternative"
  ]
}
